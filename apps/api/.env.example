DATABASE_URL="postgresql://carelens:carelens_dev@localhost:5432/carelens"
PORT=3000
JWT_ACCESS_SECRET="change_me_access_secret"
JWT_REFRESH_SECRET="change_me_refresh_secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
INFERENCE_URL="http://localhost:8001"
SEED_ADMIN_EMAIL="admin@carelens.ai"
SEED_ADMIN_PASSWORD="admin1234"
# Groq is used to draft the downloadable report's recommendations. Leave
# GROQ_API_KEY empty to use the deterministic template fallback instead.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
# Tried in order if GROQ_MODEL is unavailable or errors (Groq retires models).
GROQ_MODEL_FALLBACKS="openai/gpt-oss-120b,openai/gpt-oss-20b,allam-2-7b"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_TIMEOUT_MS=20000